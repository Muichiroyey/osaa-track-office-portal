# ─────────────────────────────────────────────────────────────
# OSAA-TRACK Office Portal — Frontend Environment
# Copy this file to ".env".
# ─────────────────────────────────────────────────────────────

# Leave blank in development: vite.config.js proxies /api to the backend
# on http://localhost:5000, which is the same backend and the same MySQL
# database the Admin Panel uses.
#
# For a deployed build, set this to the backend's public URL, e.g.
# VITE_API_BASE_URL=https://osaa-track-api.up.railway.app
VITE_API_BASE_URL=
